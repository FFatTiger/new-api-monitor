DATABASE_URL="postgresql://USERNAME:PASSWORD@postgres:5432/new-api"
API_BASE_URL="https://your-api-management-host"
API_MANAGEMENT_KEY="your-server-only-management-key"
ZAI_API_KEY="your-server-only-zai-api-key"
MINIMAX_API_KEY="your-server-only-minimax-api-key"
MINIMAX_API_REGION="auto"
MINIMAX_API_BASE_URL=""
QUOTA_USAGE_GROUPS="codex=8,17,19;claude=12,13;zai=27;minimax=24"
QUOTA_SNAPSHOT_INTERVAL_SECONDS="300"
DASHBOARD_ROLLUP_WORKER_ENABLED="false"
DASHBOARD_ROLLUP_READS_ENABLED="false"
DASHBOARD_ROLLUP_BATCH_SIZE="100"
DASHBOARD_ROLLUP_PAUSE_MS="500"
DASHBOARD_ROLLUP_STATEMENT_TIMEOUT_MS="5000"
# Optional integration tests only — never use as a production fallback:
# DASHBOARD_ROLLUP_TEST_DATABASE_URL="postgresql://..."
