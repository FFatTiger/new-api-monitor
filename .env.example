DATABASE_URL="postgresql://USERNAME:PASSWORD@postgres:5432/new-api"
API_BASE_URL="https://your-api-management-host"
API_MANAGEMENT_KEY="your-server-only-management-key"
ZAI_API_KEY="your-server-only-zai-api-key"
# Multiple Z.ai keys: comma separated list, each key gets its own quota card.
# Takes precedence over ZAI_API_KEY when set.
ZAI_API_KEYS=""
MINIMAX_API_KEY="your-server-only-minimax-api-key"
MINIMAX_API_REGION="auto"
MINIMAX_API_BASE_URL=""
QUOTA_USAGE_GROUPS="codex=8,17,19;claude=12,13;zai=27;minimax=24"
QUOTA_SNAPSHOT_INTERVAL_SECONDS="300"
DASHBOARD_ROLLUP_WORKER_ENABLED="false"
DASHBOARD_ROLLUP_READS_ENABLED="false"
DASHBOARD_ROLLUP_BATCH_SIZE="100"
DASHBOARD_ROLLUP_PAUSE_MS="500"
DASHBOARD_ROLLUP_STATEMENT_TIMEOUT_MS="5000"

# ClickHouse analytics. Keep reads disabled until the initial sync reaches the latest log ID.
CLICKHOUSE_URL="http://clickhouse:8123"
CLICKHOUSE_DATABASE="new_api_monitor"
CLICKHOUSE_USER="monitor"
CLICKHOUSE_PASSWORD="change-this-password"
CLICKHOUSE_SYNC_ENABLED="false"
CLICKHOUSE_READS_ENABLED="false"
CLICKHOUSE_SYNC_BATCH_SIZE="5000"
CLICKHOUSE_SYNC_PAUSE_MS="1000"
CLICKHOUSE_QUERY_TIMEOUT_MS="3000"
CLICKHOUSE_MAX_THREADS="2"
CLICKHOUSE_MAX_ROWS_TO_READ="5000000"
CLICKHOUSE_MAX_BYTES_TO_READ="1073741824"
CLICKHOUSE_MAX_MEMORY_USAGE="536870912"
CLICKHOUSE_MAX_CONCURRENT_QUERIES="2"
CLICKHOUSE_MAX_QUEUED_QUERIES="8"
# Optional integration tests only — never use as a production fallback:
# DASHBOARD_ROLLUP_TEST_DATABASE_URL="postgresql://..."
